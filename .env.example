# Generate the secret and keypair with: pnpm keygen
PORT=8080
AYOS_SHARED_SECRET=
# Ed25519 PUBLIC key only — Ayos verifies stream tokens, it never mints them.
STREAM_JWT_PUBLIC_KEY=
# Origin allowed to open a stream, e.g. your Laravel app.
ALLOWED_ORIGIN=http://localhost
MAX_CONCURRENT_JOBS=4
DEFAULT_TIMEOUT_S=900

# Escape hatch for local work only: skips the per-job proof that the VM's egress
# allowlist is actually enforced. Never set this against an untrusted repo.
# AYOS_SKIP_EGRESS_CHECK=1
