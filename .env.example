# Ayos takes almost nothing from the environment: everything a job needs
# arrives inside its own spec, minted per run by the caller. There is no shared
# secret, no key and no port here — a run has nothing listening.
#
# The spec itself is delivered as AYOS_JOB_SPEC (JSON) or AYOS_JOB_SPEC_FILE
# (a path) by the platform, per run. Do not put one in a file you commit.

# Wall-clock budget when the spec does not set constraints.timeout_s.
AYOS_DEFAULT_TIMEOUT_S=900

# The model the agent runs on. Must exist in the pinned Pi SDK's catalog; an
# unknown id fails the run loudly rather than silently falling back.
# AYOS_PI_MODEL=claude-sonnet-5

# GitHub Enterprise only — where the clone token is revoked after the clone.
# AYOS_GITHUB_API_URL=https://ghe.example.tld/api/v3
